{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@workspace/styles": ["./packages/styles/src/index.ts"],
      "@workspace/loginbuttonstyles": ["./packages/styles/src/styles/base/baseButtonstyles.ts"]
    }
  }
}
